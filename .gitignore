# ============================================================
# Parcel Tracking System - .gitignore
# Muc tieu: chi giu lai file can thiet cho build / cau hinh /
# kiem thu / van hanh. Tai lieu ca nhan, bao cao, ghi chu va
# moi thong tin bi mat deu phai nam o local.
# ============================================================

# ------------------------------------------------------------
# .NET build output
# ------------------------------------------------------------
bin/
obj/
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
bld/
artifacts/
*.dll
*.exe
*.pdb

# ------------------------------------------------------------
# Visual Studio
# ------------------------------------------------------------
.vs/
*.suo
*.tlb
*.tlh
*.bak
*.cache
*.log
*.user
*.userprefs
*.userosscache
*.sln.docstates
*.vcxproj.filters
*.vcxproj.user
*.vcxproj.log
*.ipch
*.aps
*.ncb
*.opensdf
*.sdf
*.sdf.bak

# ------------------------------------------------------------
# VS Code / Rider / IDE
# ------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/

# ------------------------------------------------------------
# Environment files (chi giu file mau .env.example)
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.env

# ------------------------------------------------------------
# Secrets / credentials (tuyet doi khong commit)
# ------------------------------------------------------------
secrets.json
*.secret
*.secrets
.secrets/
*.publishsettings

# ------------------------------------------------------------
# Certificates & private keys
# ------------------------------------------------------------
*.pem
*.key
*.crt
*.cer
*.der
*.pfx
*.p12
*.jks
*.keystore
*.snk
*.ppk
id_rsa*
id_ed25519*
.ssh/

# ------------------------------------------------------------
# App configuration
# Chi giu appsettings.json mac dinh va cac file .example.
# Moi appsettings.<Environment>.json duoc coi la cau hinh local
# va co the chua connection string / thong tin xac thuc.
# ------------------------------------------------------------
appsettings.*.json
!appsettings.json
!appsettings.*.json.example

# ------------------------------------------------------------
# Docker
# Luu y: .dockerignore va Dockerfile PHAI duoc quan ly bang Git.
# ------------------------------------------------------------
docker-compose.override.yml
docker-compose.*.local.yml

# ------------------------------------------------------------
# Database (file local, khong phai migration)
# ------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.mdf
*.ldf

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------
*.log
logs/
[Ll]og/
[Ll]ogs/

# ------------------------------------------------------------
# Test results / coverage
# ------------------------------------------------------------
TestResults/
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml

# ------------------------------------------------------------
# NuGet
# ------------------------------------------------------------
packages/
*.nupkg
*.snupkg
project.lock.json

# ------------------------------------------------------------
# Temporary files / OS files
# ------------------------------------------------------------
*.tmp
*.temp
*~
.~*
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------
# Git leftovers
# ------------------------------------------------------------
*.orig
*.rej

# ------------------------------------------------------------
# Tai lieu hoc tap & tai lieu noi bo (giu o local)
# Khong commit: README, de tai, huong dan, phan tich, kien truc,
# quy tac agent, bao cao va ghi chu ca nhan.
#
# LUU Y: .gitignore chi co tac dung voi file CHUA duoc Git theo doi.
# File da track phai duoc go bang: git rm --cached <file>
# ------------------------------------------------------------
README.md
detai.md
huongdan.md
analysis.md
AGENTS.md
architecture.md

# Bao cao / ghi chu / tai lieu ca nhan
report/
reports/
bao-cao/
notes/
ghi-chu/
docs/
images/
screenshots/

# Tai lieu van phong (khong phuc vu build/van hanh)
*.pdf
*.doc
*.docx
*.ppt
*.pptx
*.xls
*.xlsx

# ------------------------------------------------------------
# Backup
# ------------------------------------------------------------
*.bak
*.backup
*.old
